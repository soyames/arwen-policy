{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Policy Document Schema",
  "type": "object",
  "properties": {
    "document_id": {"type": "string", "format": "uuid"},
    "source_id": {"type": "string"},
    "text": {"type": "string"},
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "segment_id": {"type": "string", "format": "uuid"},
          "ordinal": {"type": "integer"},
          "text": {"type": "string"},
          "char_start": {"type": "integer"},
          "char_end": {"type": "integer"}
        },
        "required": ["segment_id", "ordinal", "text", "char_start", "char_end"]
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "candidate_id": {"type": "string", "format": "uuid"},
          "candidate_type": {"type": "string", "enum": ["position", "argument", "counterargument", "evidence", "stakeholder"]},
          "segment_id": {"type": "string"},
          "text": {"type": "string"},
          "extraction_method": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "evidence_linked": {"type": "boolean"},
          "evidence_confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "evidence_required": {"type": "boolean"},
          "human_verified": {"type": "boolean"}
        },
        "required": ["candidate_id", "candidate_type", "segment_id", "text", "extraction_method"]
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "title": {"type": "string"},
        "published_at": {"type": "string", "format": "date-time"},
        "content_type": {"type": "string"},
        "extraction_method": {"type": "string"}
      }
    }
  },
  "required": ["document_id", "source_id", "text", "segments", "candidates", "metadata"]
}